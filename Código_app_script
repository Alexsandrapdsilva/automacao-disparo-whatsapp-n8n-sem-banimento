/**
 * Valida o endereço comparando os dados da planilha com a BrasilAPI.
 * * @param {string} rua Nome da rua para conferência.
 * @param {string} bairro Nome do bairro para conferência.
 * @param {string} cidade Nome da cidade para conferência.
 * @param {string} estado Sigla do estado (UF) para conferência.
 * @param {string} cep O CEP a ser consultado.
 * @return {string} Status de validação ou descrição das divergências.
 * @customfunction
 */
function validarEnderecoCompleto(rua, bairro, cidade, estado, cep) {
  try {
    // 🔹 Formata o CEP: mantém apenas números e garante 8 dígitos
    cep = cep.toString().replace(/\D/g, '').trim();
    if (cep.length < 8) {
      cep = cep.padStart(8, '0');
    }

    if (cep.length !== 8) return "❌ CEP inválido";

    const url = `https://brasilapi.com.br/api/cep/v2/${cep}`;
    const response = UrlFetchApp.fetch(url, { muteHttpExceptions: true });
    const statusCode = response.getResponseCode();

    if (statusCode !== 200) {
      return `⚠️ Erro na consulta: status ${statusCode}`;
    }

    const data = JSON.parse(response.getContentText());
    if (!data || !data.street) {
      return "❌ CEP não encontrado";
    }

    // 🔹 Função interna para normalizar strings (remove acentos e padroniza caixa)
    const normalize = s => s.toString().normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase();

    let divergencias = [];
    
    if (!normalize(data.street).includes(normalize(rua))) {
      divergencias.push(`rua (${data.street})`);
    }
    if (!normalize(data.neighborhood).includes(normalize(bairro))) {
      divergencias.push(`bairro (${data.neighborhood})`);
    }
    if (!normalize(data.city).includes(normalize(cidade))) {
      divergencias.push(`cidade (${data.city})`);
    }
    if (!normalize(data.state).includes(normalize(estado))) {
      divergencias.push(`estado (${data.state})`);
    }

    return divergencias.length === 0
      ? "✅ Endereço confere com o CEP"
      : `⚠️ Divergência em: ${divergencias.join(", ")}`;

  } catch (e) {
    return `⚠️ Erro na consulta: ${e.message}`;
  }
}
